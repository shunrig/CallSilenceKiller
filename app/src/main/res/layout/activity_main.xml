<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📞 通话静音监控"
            android:textColor="#E0E0FF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="检测到对方静音时，自动挂断电话"
            android:textColor="#8888AA"
            android:textSize="13sp"
            android:layout_marginBottom="24dp"/>

        <!-- 开关卡片 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#252540"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="18dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="开启通话监控"
                        android:textColor="#E0E0FF"
                        android:textSize="16sp"/>

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚠️ 请先授予全部权限"
                        android:textColor="#FFAA44"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swEnabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="#6C63FF"
                    android:trackTint="#444466"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 参数说明卡片 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#252540"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚙️ 监控参数"
                    android:textColor="#E0E0FF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:text="静音检测时间" android:textColor="#AAAACC" android:textSize="13sp"/>
                    <TextView android:layout_width="wrap_content" android:text="10 秒" android:textColor="#6C63FF" android:textSize="13sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:text="宽限期（给重连机会）" android:textColor="#AAAACC" android:textSize="13sp"/>
                    <TextView android:layout_width="wrap_content" android:text="≤ 8 秒" android:textColor="#FF8844" android:textSize="13sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:text="挂断后总延迟" android:textColor="#AAAACC" android:textSize="13sp"/>
                    <TextView android:layout_width="wrap_content" android:text="≈ 10–18 秒" android:textColor="#FF6666" android:textSize="13sp"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 操作按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnGrant"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:text="授予权限"
                android:textColor="#FFF"
                android:backgroundTint="#6C63FF"
                android:visibility="gone"/>

            <Button
                android:id="@+id/btnTest"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:text="测试挂断"
                android:textColor="#FFF"
                android:backgroundTint="#FF5555"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- 日志区 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📋 运行日志"
            android:textColor="#8888AA"
            android:textSize="13sp"
            android:layout_marginBottom="6dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1A1A28"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <ScrollView
                android:id="@+id/svLog"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="等待运行...\n"
                    android:textColor="#44DD88"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="2dp"/>
            </ScrollView>
        </androidx.cardview.widget.CardView>

        <!-- 华为白名单提示 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💡 华为/HarmonyOS 用户：请在「设置 → 应用 → 应用启动管理」中开启本应用的自启动和后台activity权限"
            android:textColor="#666688"
            android:textSize="11sp"
            android:layout_marginTop="16dp"/>
    </LinearLayout>
</ScrollView>
